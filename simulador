
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#173b32">
  <title>Confiar | Simulador de Fe</title>

  <style>
    :root {
      --verde: #173b32;
      --verde-claro: #315e4b;
      --salvia: #dce8dc;
      --crema: #f7f3e9;
      --dorado: #d8bd7a;
      --texto: #24352e;
      --muted: #65736b;
      --blanco: #fffefa;
      --borde: #dce3d9;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--crema);
      color: var(--texto);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    button, a {
      font: inherit;
    }

    a {
      color: inherit;
    }

    button {
      cursor: pointer;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 16px 6%;
      background: var(--blanco);
      border-bottom: 1px solid var(--borde);
    }

    .logo {
      color: var(--verde);
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: 3px;
      text-decoration: none;
    }

    .logo span {
      color: #ad8c42;
    }

    nav {
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--muted);
      font-size: .92rem;
      font-weight: bold;
      text-decoration: none;
    }

    nav a:hover {
      color: var(--verde-claro);
    }

    .hero {
      padding: 100px 20px;
      color: var(--blanco);
      text-align: center;
      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(216, 189, 122, .18),
          transparent 30%
        ),
        radial-gradient(
          circle at 85% 80%,
          rgba(169, 197, 160, .16),
          transparent 30%
        ),
        var(--verde);
    }

    .hero-content {
      max-width: 780px;
      margin: auto;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 16px;
      padding: 6px 14px;
      border: 1px solid #a99561;
      border-radius: 30px;
      color: var(--dorado);
      font-size: .78rem;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1, h2, h3 {
      margin-top: 0;
    }

    h1, h2 {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: normal;
    }

    h1 {
      margin-bottom: 18px;
      font-size: clamp(2.6rem, 7vw, 5rem);
      line-height: 1.1;
    }

    .hero p {
      max-width: 600px;
      margin: 0 auto 30px;
      color: #e0e8e0;
      font-size: 1.1rem;
    }

    .button {
      display: inline-block;
      padding: 13px 24px;
      border: none;
      border-radius: 30px;
      background: var(--dorado);
      color: var(--verde);
      font-weight: bold;
      text-decoration: none;
      transition: transform .2s, filter .2s;
    }

    .button:hover {
      transform: translateY(-2px);
      filter: brightness(1.05);
    }

    .button:focus-visible,
    .choice:focus-visible,
    a:focus-visible {
      outline: 3px solid #ad8c42;
      outline-offset: 3px;
    }

    .button-dark {
      background: var(--verde);
      color: white;
    }

    .section {
      width: min(1080px, calc(100% - 40px));
      margin: auto;
      padding: 75px 0;
    }

    .section-heading {
      max-width: 650px;
      margin: 0 auto 35px;
      text-align: center;
    }

    .section-heading .eyebrow {
      color: var(--verde-claro);
      border-color: #b9cbb8;
    }

    h2 {
      margin-bottom: 12px;
      color: var(--verde);
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.2;
    }

    .section-heading p {
      color: var(--muted);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      padding: 25px;
      border: 1px solid var(--borde);
      border-radius: 20px;
      background: var(--blanco);
      box-shadow: 0 12px 35px rgba(23, 59, 50, .07);
    }

    .card-icon {
      display: grid;
      place-items: center;
      width: 55px;
      height: 55px;
      margin-bottom: 18px;
      border-radius: 16px;
      background: var(--salvia);
      color: var(--verde-claro);
      font-size: 1.7rem;
    }

    .card h3 {
      margin-bottom: 8px;
      color: var(--verde);
    }

    .card p {
      margin-bottom: 0;
      color: var(--muted);
    }

    .simulator-section {
      padding: 70px 20px;
      background: #e8eee5;
    }

    .simulator {
      width: min(760px, 100%);
      margin: auto;
      padding: clamp(22px, 5vw, 42px);
      border: 1px solid #d2ded1;
      border-radius: 24px;
      background: var(--blanco);
      box-shadow: 0 18px 50px rgba(23, 59, 50, .1);
    }

    .simulator .section-heading {
      margin-bottom: 28px;
    }

    .question {
      margin-bottom: 15px;
      color: var(--verde);
      font-weight: bold;
    }

    .choices {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .choice {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 75px;
      padding: 15px;
      border: 1px solid var(--borde);
      border-radius: 14px;
      background: white;
      color: var(--texto);
      text-align: left;
      transition: background .2s, border-color .2s;
    }

    .choice:hover {
      border-color: var(--verde-claro);
    }

    .choice[aria-pressed="true"] {
      border-color: var(--verde-claro);
      background: var(--salvia);
      box-shadow: inset 0 0 0 1px var(--verde-claro);
    }

    .emoji {
      font-size: 1.5rem;
    }

    .actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 22px;
    }

    .hint {
      margin: 0;
      color: var(--muted);
      font-size: .9rem;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: .5;
      transform: none;
    }

    .result {
      margin-top: 25px;
      padding: 25px;
      border-radius: 18px;
      background: var(--verde);
      color: white;
    }

    .result[hidden] {
      display: none;
    }

    .result-label {
      margin-bottom: 8px;
      color: var(--dorado);
      font-size: .8rem;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .result h3 {
      margin-bottom: 12px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.8rem;
      font-weight: normal;
    }

    .result-message {
      color: #e2eae2;
    }

    .verse {
      margin: 20px 0 12px;
      padding-left: 16px;
      border-left: 3px solid var(--dorado);
      color: #fff6df;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.1rem;
    }

    .reference {
      color: #cbd8ce;
      font-size: .85rem;
    }

    .result-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 22px;
    }

    .reflection {
      padding: 70px 20px;
      background: var(--blanco);
      text-align: center;
    }

    .reflection blockquote {
      max-width: 760px;
      margin: auto;
      color: var(--verde);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.5rem, 4vw, 2.3rem);
      line-height: 1.4;
    }

    .reflection p {
      margin-bottom: 0;
      color: var(--muted);
    }

    footer {
      padding: 25px 15px;
      background: var(--verde);
      color: #d9e4da;
      text-align: center;
      font-size: .9rem;
    }

    footer p {
      margin: 5px;
    }

    @media (max-width: 700px) {
      .header {
        align-items: flex-start;
        flex-direction: column;
      }

      nav {
        gap: 14px;
      }

      .hero {
        padding: 75px 20px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .choices {
        grid-template-columns: 1fr;
      }

      .section {
        padding: 50px 0;
      }

      .simulator-section {
        padding: 45px 15px;
      }

      .actions {
        align-items: stretch;
        flex-direction: column;
      }

      .actions .button {
        text-align: center;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- ENCABEZADO -->
  <header class="header">
    <a class="logo" href="#inicio">✦ <span>CONFIAR</span></a>

    <nav aria-label="Navegación principal">
      <a href="#pilares">Pilares</a>
      <a href="#simulador">Simulador</a>
      <a href="#reflexion">Reflexión</a>
    </nav>
  </header>

  <main>

    <!-- PORTADA -->
    <section class="hero" id="inicio">
      <div class="hero-content">
        <span class="eyebrow">Un momento para el alma</span>

        <h1>Encuentra paz en tu camino</h1>

        <p>
          Haz una pausa, reconoce lo que estás sintiendo
          y encuentra una palabra de esperanza para acompañarte hoy.
        </p>

        <a class="button" href="#simulador">
          Comenzar simulador →
        </a>
      </div>
    </section>

    <!-- TARJETAS INFORMATIVAS -->
    <section class="section" id="pilares">
      <div class="section-heading">
        <span class="eyebrow">Tres recordatorios</span>
        <h2>Una fe que te acompaña</h2>
        <p>
          Pequeñas verdades para recordar en los diferentes
          momentos de la vida.
        </p>
      </div>

      <div class="cards">

        <article class="card">
          <div class="card-icon" aria-hidden="true">♧</div>
          <h3>Protección</h3>
          <p>
            Recuerda que no tienes que enfrentar cada dificultad
            sin esperanza ni apoyo.
          </p>
        </article>

        <article class="card">
          <div class="card-icon" aria-hidden="true">♡</div>
          <h3>Refugio</h3>
          <p>
            Regálate un momento de calma para respirar,
            reflexionar y encontrar consuelo.
          </p>
        </article>

        <article class="card">
          <div class="card-icon" aria-hidden="true">✧</div>
          <h3>Propósito</h3>
          <p>
            Aunque no tengas todas las respuestas, puedes
            dar el siguiente paso con paciencia y confianza.
          </p>
        </article>

      </div>
    </section>

    <!-- SIMULADOR -->
    <section class="simulator-section" id="simulador">
      <div class="simulator">

        <div class="section-heading">
          <span class="eyebrow">Simulador de fe</span>
          <h2>¿Cómo te sientes hoy?</h2>
          <p>
            Selecciona la opción que mejor represente
            lo que estás viviendo.
          </p>
        </div>

        <p class="question" id="question-label">
          Selecciona una emoción:
        </p>

        <div class="choices" role="group" aria-labelledby="question-label">

          <button class="choice" type="button"
                  data-feeling="ansiedad" aria-pressed="false">
            <span class="emoji" aria-hidden="true">🌧️</span>
            <span>Estoy preocupado o con ansiedad</span>
          </button>

          <button class="choice" type="button"
                  data-feeling="tristeza" aria-pressed="false">
            <span class="emoji" aria-hidden="true">💧</span>
            <span>Me siento triste o desanimado</span>
          </button>

          <button class="choice" type="button"
                  data-feeling="incertidumbre" aria-pressed="false">
            <span class="emoji" aria-hidden="true">🌫️</span>
            <span>No sé qué decisión tomar</span>
          </button>

          <button class="choice" type="button"
                  data-feeling="fortaleza" aria-pressed="false">
            <span class="emoji" aria-hidden="true">🌱</span>
            <span>Necesito fuerzas para continuar</span>
          </button>

        </div>

        <div class="actions">
          <p class="hint" id="hint" aria-live="polite">
            Selecciona una opción para continuar.
          </p>

          <button class="button button-dark" id="show-result"
                  type="button" disabled>
            Ver mi reflexión
          </button>
        </div>

        <!-- RESULTADO DINÁMICO -->
        <section class="result" id="result"
                 aria-live="polite" aria-atomic="true" hidden>

          <p class="result-label">Una palabra para ti</p>

          <h3 id="result-title"></h3>

          <p class="result-message" id="result-message"></p>

          <blockquote class="verse" id="result-verse"></blockquote>

          <p class="reference" id="result-reference"></p>

          <div class="result-actions">
            <button class="button" id="try-again" type="button">
              Elegir otra emoción
            </button>

            <button class="button" id="copy-result" type="button">
              Copiar reflexión
            </button>
          </div>

          <p id="copy-status" class="reference"
             aria-live="polite"></p>
        </section>

      </div>
    </section>

    <!-- REFLEXIÓN FINAL -->
    <section class="reflection" id="reflexion">
      <blockquote>
        «El Señor es mi pastor, nada me falta».
      </blockquote>

      <p>Salmo 23, 1</p>
    </section>

  </main>

  <!-- PIE DE PÁGINA -->
  <footer>
    <p><strong>CONFIAR</strong> · Un espacio para la reflexión y la esperanza.</p>
    <p>Dedica un momento a la calma, la reflexión y la fe.</p>
  </footer>

  <script>
    /*
      CONTENIDO DEL SIMULADOR

      Puedes cambiar los títulos, mensajes y referencias
      dentro de este objeto sin modificar el diseño.
    */

    const reflections = {
      ansiedad: {
        title: "Respira y confía",
        message:
          "No tienes que resolverlo todo en este instante. " +
          "Haz una pausa, respira con calma y avanza paso a paso. " +
          "Si la preocupación pesa demasiado, hablar con alguien " +
          "de confianza también puede ayudarte.",
        verse:
          "«No se inquieten por nada; más bien, en toda ocasión, " +
          "con oración y ruego, presenten sus peticiones a Dios».",
        reference:
          "Filipenses 4, 6. Verifica la redacción en tu Biblia."
      },

      tristeza: {
        title: "No estás sin esperanza",
        message:
          "Está bien reconocer la tristeza y darte tiempo. " +
          "No necesitas fingir que todo está bien. Busca compañía " +
          "si la necesitas y recuerda que los momentos difíciles " +
          "no definen toda tu historia.",
        verse:
          "«El Señor está cerca de los que tienen el corazón herido».",
        reference:
          "Salmo 34, 18. La redacción varía según la traducción."
      },

      incertidumbre: {
        title: "Da un paso a la vez",
        message:
          "No siempre es posible ver el camino completo. " +
          "Puedes detenerte, buscar consejo y tomar una decisión " +
          "a la vez, con paciencia y reflexión.",
        verse:
          "«Confía en el Señor con todo tu corazón».",
        reference:
          "Proverbios 3, 5. Consulta tu traducción bíblica preferida."
      },

      fortaleza: {
        title: "Sigue adelante con paciencia",
        message:
          "No tienes que poder con todo por tu cuenta. Descansar, " +
          "pedir ayuda y retomar fuerzas también son parte del camino. " +
          "Concéntrate en el siguiente paso posible.",
        verse:
          "«Todo lo puedo en aquel que me fortalece».",
        reference:
          "Filipenses 4, 13. Lee el pasaje completo en su contexto."
      }
    };

    const choices = document.querySelectorAll(".choice");
    const showButton = document.getElementById("show-result");
    const result = document.getElementById("result");
    const hint = document.getElementById("hint");

    let selectedFeeling = null;
    let currentReflection = null;

    // Seleccionar una emoción.
    choices.forEach(function(choice) {
      choice.addEventListener("click", function() {
        selectedFeeling = choice.dataset.feeling;

        choices.forEach(function(item) {
          item.setAttribute(
            "aria-pressed",
            String(item === choice)
          );
        });

        showButton.disabled = false;
        result.hidden = true;
        hint.textContent =
          "Opción seleccionada. Ya puedes ver tu reflexión.";
      });
    });

    // Mostrar la reflexión correspondiente.
    showButton.addEventListener("click", function() {
      if (!selectedFeeling) return;

      currentReflection = reflections[selectedFeeling];

      document.getElementById("result-title").textContent =
        currentReflection.title;

      document.getElementById("result-message").textContent =
        currentReflection.message;

      document.getElementById("result-verse").textContent =
        currentReflection.verse;

      document.getElementById("result-reference").textContent =
        currentReflection.reference;

      document.getElementById("copy-status").textContent = "";
      result.hidden = false;

      result.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });
    });

    // Reiniciar para elegir otra emoción.
    document.getElementById("try-again").addEventListener(
      "click",
      function() {
        selectedFeeling = null;
        currentReflection = null;

        choices.forEach(function(item) {
          item.setAttribute("aria-pressed", "false");
        });

        showButton.disabled = true;
        result.hidden = true;

        hint.textContent =
          "Selecciona una opción para continuar.";

        document.getElementById("simulador").scrollIntoView({
          behavior: "smooth"
        });
      }
    );

    // Copiar la reflexión seleccionada.
    document.getElementById("copy-result").addEventListener(
      "click",
      async function() {
        if (!currentReflection) return;

        const textToCopy =
          currentReflection.title + "\n\n" +
          currentReflection.message + "\n\n" +
          currentReflection.verse + "\n" +
          currentReflection.reference;

        const status = document.getElementById("copy-status");

        try {
          await navigator.clipboard.writeText(textToCopy);
          status.textContent = "Reflexión copiada.";
        } catch (error) {
          status.textContent =
            "No se pudo copiar automáticamente. " +
            "Abre el sitio mediante HTTPS o copia el texto manualmente.";
        }
      }
    );
  </script>

</body>
</html>
